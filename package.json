{
  "name": "meeplesbg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "hotness:sync": "npx tsx --env-file=.env --env-file=.env.local scripts/hotness-sync.ts",
    "import:games": "npx tsx --env-file=.env --env-file=.env.local scripts/import-games.ts",
    "import:bgg": "npx tsx --env-file=.env scripts/import-bgg.ts",
    "import:reindex": "npx tsx --env-file=.env --env-file=.env.local scripts/reindex.ts",
    "translate": "npx tsx --env-file=.env scripts/translate-descriptions.ts",
    "upload:images": "npx tsx --env-file=.env scripts/upload-images.ts",
    "import:mechanics": "npx tsx --env-file=.env --env-file=.env.local scripts/refresh-types.ts",
    "partners:send": "npx tsx --env-file=.env.local scripts/send-partner-email.ts",
    "write:article": "npx tsx --env-file=.env --env-file=.env.local scripts/write-article.ts",
    "expansions:import": "npx tsx --env-file=.env --env-file=.env.local scripts/import-expansions.ts",
    "bgg:refresh-rank": "npx tsx --env-file=.env --env-file=.env.local scripts/refresh-bgg-rank.ts",
    "sync:ranks": "npx tsx --env-file=.env --env-file=.env.local scripts/sync-category-ranks.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.62.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "meilisearch": "^0.62.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.31",
    "next-sanity": "^13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.35.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "adm-zip": "^0.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
