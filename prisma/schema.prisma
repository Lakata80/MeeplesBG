// Prisma схема за MeeplesBG
// Prisma 5 с PostgreSQL (Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// =====================
// АВТЕНТИКАЦИЯ (NextAuth v5)
// =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// ПОТРЕБИТЕЛИ
// =====================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String           @id @default(cuid())
  email         String?          @unique
  name          String?
  image         String?
  emailVerified DateTime?
  bggUsername   String?
  passwordHash  String?          @db.Text
  role          UserRole         @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  sessions      Session[]
  collection    UserCollection[]
  reviews       Review[]
  comments      Comment[]
  blogComments  BlogComment[]
  blogPosts     BlogPost[]
  pendingImages PendingImage[]
}

// =====================
// НАСТОЛНИ ИГРИ
// =====================

model Game {
  id              String           @id @default(cuid())
  bggId           Int?             @unique
  slug            String           @unique
  titleBg         String
  titleEn         String?
  descriptionBg   String?          @db.Text
  descriptionEn   String?          @db.Text
  yearPublished   Int?
  minPlayers      Int?
  maxPlayers      Int?
  minPlaytime     Int?
  maxPlaytime     Int?
  minAge          Int?
  weight          Float?
  bggRating       Float?
  ourRating       Float?
  imageUrl        String?
  thumbnailUrl    String?
  categories      String[]
  mechanics       String[]
  types           String[]
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  expansions      Game[]           @relation("BaseExpansion")
  baseGame        Game?            @relation("BaseExpansion", fields: [baseGameId], references: [id])
  baseGameId      String?
  userCollections UserCollection[]
  reviews         Review[]
  comments        Comment[]
  pendingImages   PendingImage[]
}

// =====================
// КОЛЕКЦИЯ НА ПОТРЕБИТЕЛЯ
// =====================

enum CollectionStatus {
  OWNS
  WISHLIST
  PLAYED
  FORSALE
}

model UserCollection {
  id        String           @id @default(cuid())
  userId    String
  gameId    String
  status    CollectionStatus
  rating    Int?
  playCount Int              @default(0)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

// =====================
// РЕВЮТА
// =====================

model Review {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  title       String
  content     String   @db.Text
  rating      Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

// =====================
// КОМЕНТАРИ
// =====================

model Comment {
  id         String    @id @default(cuid())
  userId     String
  gameId     String
  content    String    @db.Text
  parentId   String?
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    Comment[] @relation("CommentReplies")
}

// =====================
// БЛОГ / НОВИНИ
// =====================

enum BlogCategory {
  NEWS
  REVIEW
  BLOG
  GUIDE
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  titleBg     String
  titleEn     String?
  contentBg   String       @db.Text
  contentEn   String?      @db.Text
  excerpt     String?      @db.Text
  imageUrl    String?
  authorId    String
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  category    BlogCategory @default(BLOG)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation(fields: [authorId], references: [id])
}

// =====================
// КОМЕНТАРИ КЪМ БЛОГ СТАТИИ (Sanity)
// =====================

// postSlug свързва коментара към Sanity статия по нейния slug.
model BlogComment {
  id         String        @id @default(cuid())
  userId     String
  postSlug   String
  content    String        @db.Text
  parentId   String?
  isApproved Boolean       @default(true)
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    BlogComment[] @relation("BlogCommentReplies")

  @@index([postSlug])
}

// =====================
// ПОТРЕБИТЕЛСКИ СНИМКИ (ОЧАКВАЩИ ОДОБРЕНИЕ)
// =====================

enum ImageStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingImage {
  id        String      @id @default(cuid())
  gameId    String
  userId    String
  url       String
  status    ImageStatus @default(PENDING)
  createdAt DateTime    @default(now())
  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================
// МЕХАНИКИ
// =====================

model Mechanic {
  id            String   @id @default(cuid())
  bggId         Int?     @unique
  slug          String   @unique
  name          String   @unique
  descriptionEn String?  @db.Text
  descriptionBg String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =====================
// АБОНАМЕНТИ ЗА БЮЛЕТИН
// =====================

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique @default(uuid())
  createdAt        DateTime @default(now())
}
