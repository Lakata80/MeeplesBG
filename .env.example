# ─────────────────────────────────────────────
# База данни
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/meeplesbg?connection_limit=5&pool_timeout=20&connect_timeout=15"

# ─────────────────────────────────────────────
# Автентикация (NextAuth v5)
# Генерирай с: openssl rand -hex 32
# ─────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://meeplesbg.com"

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — developers.facebook.com
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Сайт
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://meeplesbg.com"

# ─────────────────────────────────────────────
# Sanity CMS
# ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""

# ─────────────────────────────────────────────
# MeiliSearch (търсене)
# ─────────────────────────────────────────────
MEILI_HOST="https://search.meeplesbg.com"
MEILI_API_KEY=""

# ─────────────────────────────────────────────
# Cloudflare R2 (снимки на игри)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="meeplesbg-images"
R2_PUBLIC_URL="https://images.meeplesbg.com"

# ─────────────────────────────────────────────
# Upstash Redis (rate limiting)
# console.upstash.com → Redis → REST API
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────
# Resend (имейли)
# resend.com → API Keys
# ─────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="MeeplesBG <newsletter@meeplesbg.com>"
RESEND_PARTNERS_FROM="MeeplesBG Партньорства <partners@meeplesbg.com>"

# ─────────────────────────────────────────────
# YouTube (видеа към игри)
# console.cloud.google.com → YouTube Data API v3
# ─────────────────────────────────────────────
YOUTUBE_API_KEY=""

# ─────────────────────────────────────────────
# Скриптове (не са нужни за production сървъра)
# ─────────────────────────────────────────────

# Anthropic Claude (автоматични преводи на описания)
ANTHROPIC_API_KEY=""

# BGG API (по подразбиране: https://boardgamegeek.com/xmlapi2)
# BGG_API_URL=""
# BGG_API_TOKEN=""

# BGG сесия — нужна само за скрипта за масов импорт
# BGG_SESSION_COOKIE=""

# Път до BGG dump файл — само за scripts/import-bgg.ts
# BGG_DUMP_FILE="/path/to/bgg-dump.zip"
